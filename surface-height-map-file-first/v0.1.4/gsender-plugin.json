{
  "id": "com.bakstaaj.surface-height-map-file-first",
  "name": "Surface Height Map (File First)",
  "description": "Import projects, create a centered or zero-origin surface scan, and reuse it to compensate files within its bounds.",
  "version": "0.1.4",
  "engine": ">=1.7.0-Edge-1",
  "ui": {
    "entry": "ui/index.html",
    "contributions": [
      { "slot": "tools-page", "route": "surface-height-map-file-first", "label": "Surface Height Map (File First)" }
    ]
  },
  "parsers": [
    {
      "id": "probe-report",
      "label": "Probe contact position",
      "mode": "line",
      "match": {
        "source": "^\\[PRB:(?<x>[-\\d.]+),(?<y>[-\\d.]+),(?<z>[-\\d.]+)(?<rest>(?:,[-\\d.]+)*):(?<success>[01])\\]\\s*$"
      }
    }
  ],
  "permissions": ["machine:read", "machine:write", "machine:parse", "machine:query", "storage", "visualizer:load"],
  "capabilities": {
    "requestTypes": [
      "machine:get:context", "machine:command", "machine:query", "machine:busy:set",
      "machine:parser:register", "machine:parser:unregister",
      "storage:get", "storage:set", "storage:delete", "storage:get:all", "storage:set:all",
      "gcode:load:to:visualizer"
    ],
    "topics": ["controller", "parser"],
    "allowedFunctions": ["machine", "storage", "gcode"]
  }
}
